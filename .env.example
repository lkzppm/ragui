# Nothing here is needed to run the app: documents are chunked, embedded and
# searched in the browser. These only matter once generation is built.

# Groq API key, free tier: https://console.groq.com/keys
# Without it, generation is off and everything else works.
GROQ_API_KEY=

# The model that writes the answer.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. When set, /api/answer requires this code from the client.
ACCESS_CODE=
